{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean-allure-report",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "if exist allure-report rmdir /s /q allure-report"
      ]
    },
    {
      "label": "generate-allure-report",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "if exist allure-results\\*.json allure generate allure-results -o allure-report --open"
      ]
    },
    {
      "label": "serve-allure-report",
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean-allure-report",
        "generate-allure-report"
      ]
    }
  ]
}